---
// src/components/Header.astro
// Site header component with minimal design - full width

import Navbar from "./Navbar.astro";

export interface Props {
  currentPage?: string;
}

const { currentPage = "" } = Astro.props;
---

<header class="site-header">
  <div class="header-container">
    <a class="brand" href="/">
      <span class="brand-initials">KC</span>
      <span class="brand-name">Killian Chandeze</span>
    </a>

    <Navbar currentPage={currentPage} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: saturate(1.1) blur(16px);
    -webkit-backdrop-filter: saturate(1.1) blur(16px);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.65rem 4%;
    gap: 1.5rem;
    min-height: 60px;
  }

  /* Brand - unified with nav color */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .brand:hover {
    opacity: 0.9;
  }

  .brand:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .brand-initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: -0.5px;
    transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .brand:hover .brand-initials {
    background: var(--bg-elev);
    color: var(--text);
    border: 1px solid var(--border);
    transform: scale(1.05);
  }

  .brand:active .brand-initials {
    transform: scale(0.98);
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  :global([data-theme="light"]) .site-header {
    background: var(--bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global([data-theme="light"]) .brand-initials {
    background: var(--text);
    color: var(--bg);
  }

  :global([data-theme="light"]) .brand:hover .brand-initials {
    background: var(--bg-elev);
    color: var(--text);
    border: 1px solid var(--border);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header-container {
      padding: 0.65rem 4%;
    }

    .brand-initials {
      width: 32px;
      height: 32px;
      font-size: 0.8rem;
    }

    .brand-name {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.6rem 1rem;
    }

    .brand-name {
      display: none;
    }

    .brand-initials {
      width: 36px;
      height: 36px;
      font-size: 0.9rem;
    }
  }
</style>
