---
// src/components/sections/Experience.astro
// Experience section component with working Load More/Show Less toggle

import Section from "../common/Section.astro";
import Card from "../common/Card.astro";
import Badge from "../common/Badge.astro";
import { experienceData } from "../../data/experience";
import type { ExperienceEntry } from "../../types";

export interface Props {
  /** Custom experience data (overrides default) */
  experiences?: ExperienceEntry[];
  /** Number of experiences to show initially */
  initialCount?: number;
  /** Additional CSS classes */
  class?: string;
}

const {
  experiences = experienceData,
  initialCount = 3,
  class: className = "",
} = Astro.props;

// Split experiences into visible and hidden
const visibleExperiences = experiences.slice(0, initialCount);
const hiddenExperiences = experiences.slice(initialCount);
const hasMoreExperiences = hiddenExperiences.length > 0;
const totalExperiences = experiences.length;
---

<Section id="experience" title="Professional Experience" class={className}>
  <div class="experience-container">
    {/* Initially visible experiences */}
    <div class="experience-list">
      {
        visibleExperiences.map((job) => (
          <Card hoverable class="experience-card">
            <header class="card-head meta-row">
              <div class="meta-left">
                <h3>{job.title}</h3>
                <div class="meta-line">
                  <i
                    class="fa-sharp fa-solid fa-location-dot"
                    aria-hidden="true"
                  />
                  <span>{job.location}</span>
                </div>
              </div>
              <div class="meta-right">
                <div class="org-badge">{job.company}</div>
                <div class="meta-date">
                  {job.startDate} — {job.endDate}
                </div>
              </div>
            </header>

            <ul class="card-list">
              {job.description.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            {job.skills.length > 0 && (
              <div class="kw-list">
                {job.skills.map((skill) => (
                  <Badge variant="default" size="sm" hoverable>
                    {skill}
                  </Badge>
                ))}
              </div>
            )}
          </Card>
        ))
      }
    </div>

    {/* Hidden experiences - collapsed by default */}
    {
      hasMoreExperiences && (
        <div
          class="experience-extra"
          id="experience-extra"
          data-collapsed="true"
        >
          {hiddenExperiences.map((job) => (
            <Card hoverable class="experience-card">
              <header class="card-head meta-row">
                <div class="meta-left">
                  <h3>{job.title}</h3>
                  <div class="meta-line">
                    <i
                      class="fa-sharp fa-solid fa-location-dot"
                      aria-hidden="true"
                    />
                    <span>{job.location}</span>
                  </div>
                </div>
                <div class="meta-right">
                  <div class="org-badge">{job.company}</div>
                  <div class="meta-date">
                    {job.startDate} — {job.endDate}
                  </div>
                </div>
              </header>

              <ul class="card-list">
                {job.description.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              {job.skills.length > 0 && (
                <div class="kw-list">
                  {job.skills.map((skill) => (
                    <Badge variant="default" size="sm" hoverable>
                      {skill}
                    </Badge>
                  ))}
                </div>
              )}
            </Card>
          ))}
        </div>
      )
    }

    {/* Toggle button */}
    {
      hasMoreExperiences && (
        <div class="toggle-container">
          <button
            type="button"
            class="toggle-btn"
            id="experience-toggle"
            data-more-text={`Show More (${hiddenExperiences.length})`}
            data-less-text="Show Less"
          >
            <span class="toggle-text">
              Show More ({hiddenExperiences.length})
            </span>
            <i
              class="fa-solid fa-chevron-down toggle-icon"
              aria-hidden="true"
            />
          </button>
        </div>
      )
    }
  </div>
</Section>

<style>
  .experience-container {
    display: flex;
    flex-direction: column;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Hidden experiences section */
  .experience-extra {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.5s ease,
      opacity 0.3s ease,
      margin 0.3s ease;
    margin-top: 0;
  }

  .experience-extra[data-collapsed="false"] {
    max-height: 5000px; /* Large enough for content */
    opacity: 1;
    margin-top: 0;
  }

  /* Toggle button container */
  .toggle-container {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn:hover {
    color: var(--text);
    border-color: var(--text);
    background: transparent;
  }

  .toggle-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .toggle-icon {
    font-size: 0.7rem;
    transition: transform 0.3s ease;
  }

  .toggle-btn.expanded .toggle-icon {
    transform: rotate(180deg);
  }

  /* Card header layout */
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .card-head h3 {
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.2rem);
    line-height: 1.2;
    margin: 0 0 0.2rem;
    color: var(--text);
  }

  /* Meta row layout */
  .meta-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .meta-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-right {
    color: var(--muted);
    min-width: 160px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  /* Location line */
  .meta-line {
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
  }

  .meta-line i {
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* Organization badge */
  .org-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
    font-size: 0.825rem;
    letter-spacing: 0.01em;
    transition: border-color 0.2s ease;
  }

  /* Date display */
  .meta-date {
    font-size: 0.825rem;
    color: var(--muted);
  }

  /* Description list */
  .card-list {
    margin: 0.5rem 0 1rem 1.2rem;
    padding: 0;
    list-style: disc;
  }

  .card-list li {
    margin: 0.35rem 0;
    line-height: 1.55;
    color: var(--text);
    font-size: 0.925rem;
  }

  .card-list li::marker {
    color: var(--muted);
  }

  /* Skills/keywords list */
  .kw-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Light theme adjustments */
  :global([data-theme="light"]) .org-badge {
    background: var(--bg-elev);
    border-color: var(--border);
  }

  :global([data-theme="light"]) .toggle-btn:hover {
    border-color: var(--text);
    background: transparent;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .card-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .meta-right {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      text-align: left;
      min-width: auto;
    }

    .card-head h3 {
      font-size: 1.05rem;
    }

    .org-badge {
      font-size: 0.775rem;
    }

    .meta-date {
      font-size: 0.775rem;
    }

    .card-list {
      margin-left: 1rem;
    }

    .card-list li {
      font-size: 0.9rem;
      margin: 0.3rem 0;
    }

    .kw-list {
      gap: 0.35rem;
    }

    .toggle-btn {
      padding: 0.55rem 1rem;
      font-size: 0.825rem;
    }
  }

  @media (max-width: 480px) {
    .meta-right {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }

    .card-head h3 {
      font-size: 1rem;
    }

    .meta-line {
      font-size: 0.825rem;
    }

    .card-list li {
      font-size: 0.875rem;
    }
  }

  /* Touch device optimizations */
  @media (hover: none) and (pointer: coarse) {
    .toggle-btn:hover {
      color: var(--muted);
      border-color: var(--border);
      background: transparent;
    }

    .toggle-btn:active {
      color: var(--text);
      border-color: var(--text);
      background: var(--bg-elev);
    }
  }
</style>

<script>
  // Experience toggle functionality
  function initExperienceToggle() {
    const toggleBtn = document.getElementById(
      "experience-toggle",
    ) as HTMLButtonElement;
    const extraSection = document.getElementById("experience-extra");

    if (!toggleBtn || !extraSection) {
      return;
    }

    // Get text values from data attributes
    const moreText = toggleBtn.getAttribute("data-more-text") || "Show More";
    const lessText = toggleBtn.getAttribute("data-less-text") || "Show Less";
    const textSpan = toggleBtn.querySelector(".toggle-text");

    // Set initial state
    let isExpanded = false;

    // Handle click
    toggleBtn.addEventListener("click", function () {
      isExpanded = !isExpanded;

      if (isExpanded) {
        // Expand
        extraSection.setAttribute("data-collapsed", "false");
        toggleBtn.classList.add("expanded");
        if (textSpan) {
          textSpan.textContent = lessText;
        }
      } else {
        // Collapse
        extraSection.setAttribute("data-collapsed", "true");
        toggleBtn.classList.remove("expanded");
        if (textSpan) {
          textSpan.textContent = moreText;
        }

        // Scroll back to experience section
        const experienceSection = document.getElementById("experience");
        if (experienceSection) {
          setTimeout(() => {
            experienceSection.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }, 100);
        }
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initExperienceToggle);
  } else {
    initExperienceToggle();
  }

  // Also initialize on Astro page transitions (View Transitions API)
  document.addEventListener("astro:page-load", initExperienceToggle);
</script>
